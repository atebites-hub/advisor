{
  "description": "Activate Advisor, snapshot the root policy, and enforce supported Codex delegation entrypoints.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/session-context.sh\"",
            "timeout": 5,
            "statusMessage": "Activating Advisor"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "collaborationspawn_agent|spawn_agent|Agent|mcp__open_dynamic_workflows__workflow|mcp__open-dynamic-workflows__workflow",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/enforce-codex.sh\"",
            "timeout": 5,
            "statusMessage": "Enforcing Advisor runtime policy"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/session-context.sh\"",
            "timeout": 5,
            "statusMessage": "Applying Advisor grunt context"
          }
        ]
      }
    ]
  }
}
