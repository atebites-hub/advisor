#!/bin/sh
set -eu

fail() { printf '%s\n' "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"; }

usage() {
  printf '%s\n' \
    'Usage:' \
    '  advisor configure --host codex|zcode --advisor-model MODEL --advisor-effort EFFORT --grunt-model MODEL --grunt-effort EFFORT' \
    '  advisor apply --host codex|zcode' \
    '  advisor doctor --host codex|zcode|grok|cursor|claude [--json]' \
    '  configure accepts any catalog-backed advisor/grunt pair. Codex and ZCode factory apply use the Sol/Ultra + Luna/High preset only.' \
    '  ZCode apply/configure write those tuples into plugin settings (`~/.zcode/cli/config.json` or ZCODE_CONFIG). They do not rewrite host model or provider credentials.' \
    '  doctor reports odwPlugin.compatible=true only when open-dynamic-workflows@open-dynamic-workflows is installed+enabled at version 0.3.0 on that Codex or ZCode host. Marketplace package.json at 0.3.0 is not enough.' \
    '  If compatible=false, install/enable open-dynamic-workflows@0.3.0 on that host.' \
    '  Cursor CLI is `agent` / `cursor-agent`. Doctor reports gaps; it does not enable delegation.' \
    '  Claude: prefer ultracode / Opus plan when that is the right tool; doctor defers to that native path (`nativeAdvisor=unverified`) and never enables plugin-strict seating.' \
    '  Native-first with ODW alignment required: detect ultracode / Codex ultra / Cursor multitask, do not fight them, compose or explicitly defer. Alignment is unproven; unused ODW is not a pass.' \
    '  advisor remove --host codex'
}

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd) || exit 1
plugin_dir=$(CDPATH= cd "$script_dir/.." && pwd) || exit 1
installer=$plugin_dir/scripts/install-agents.sh

if [ -n "${ADVISOR_CONFIG_HOME-}" ]; then
  config_dir=$ADVISOR_CONFIG_HOME
elif [ -n "${XDG_CONFIG_HOME-}" ]; then
  config_dir=$XDG_CONFIG_HOME/advisor
else
  [ -n "${HOME-}" ] || fail "HOME is unset; set ADVISOR_CONFIG_HOME explicitly."
  config_dir=$HOME/.config/advisor
fi
case "$config_dir" in /*) ;; *) config_dir=$(pwd -P)/$config_dir ;; esac
case "$config_dir" in /|//) fail "refusing to use the filesystem root as Advisor configuration home." ;; esac
profile=$config_dir/codex.json
default_advisor_model=gpt-5.6-sol
default_advisor_effort=ultra
default_grunt_model=gpt-5.6-luna
default_grunt_effort=high
odw_plugin_id=open-dynamic-workflows@open-dynamic-workflows
odw_required_version=0.3.0
odw_install_hint='install/enable open-dynamic-workflows@0.3.0'

path_exists() { [ -e "$1" ] || [ -L "$1" ]; }
# GNU coreutils first: `stat -f` is --file-system, not BSD format. Trying BSD
# first prints filesystem status to stdout on Linux, then concatenates the GNU
# fallback, so mode checks see garbage instead of 600.
file_mode() {
  if stat -c %a "$1" >/dev/null 2>&1; then
    stat -c %a "$1"
  else
    stat -f %Lp "$1"
  fi
}

validate_config_dir() {
  if path_exists "$config_dir" && { [ -L "$config_dir" ] || [ ! -d "$config_dir" ]; }; then
    fail "Advisor configuration home is not a real directory: $config_dir"
  fi
}

valid_model() {
  printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,255}$'
}

valid_effort() {
  printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$'
}

profile_is_valid() {
  candidate=$1
  [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -r "$candidate" ] && [ "$(file_mode "$candidate")" = 600 ] || return 1
  jq -e '
    type == "object" and keys == ["advisor","grunt","host","schemaVersion"] and
    .schemaVersion == 1 and .host == "codex" and
    (.advisor | type == "object" and keys == ["effort","model"] and
      (.model | type == "string" and length > 0) and (.effort | type == "string" and length > 0)) and
    (.grunt | type == "object" and keys == ["effort","model"] and
      (.model | type == "string" and length > 0) and (.effort | type == "string" and length > 0))
  ' "$candidate" >/dev/null 2>&1 || return 1
  profile_advisor_model=$(jq -r '.advisor.model' "$candidate")
  profile_advisor_effort=$(jq -r '.advisor.effort' "$candidate")
  profile_grunt_model=$(jq -r '.grunt.model' "$candidate")
  profile_grunt_effort=$(jq -r '.grunt.effort' "$candidate")
  valid_model "$profile_advisor_model" && valid_effort "$profile_advisor_effort" &&
    valid_model "$profile_grunt_model" && valid_effort "$profile_grunt_effort"
}

catalog_path() {
  if [ -n "${ADVISOR_MODEL_CATALOG-}" ]; then
    printf '%s\n' "$ADVISOR_MODEL_CATALOG"
  elif [ -n "${CODEX_HOME-}" ]; then
    printf '%s\n' "$CODEX_HOME/models_cache.json"
  elif [ -n "${HOME-}" ]; then
    printf '%s\n' "$HOME/.codex/models_cache.json"
  else
    printf '%s\n' ''
  fi
}

catalog_is_available() {
  candidate=$1
  [ -n "$candidate" ] && [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -r "$candidate" ] &&
    jq -e '.models | type == "array"' "$candidate" >/dev/null 2>&1
}

catalog_has_tuple() {
  candidate=$1 model=$2 effort=$3
  jq -e --arg model "$model" --arg effort "$effort" '
    any(.models[]?; .slug == $model and any(.supported_reasoning_levels[]?; .effort == $effort))
  ' "$candidate" >/dev/null 2>&1
}

require_catalog_tuples() {
  catalog=$(catalog_path)
  if path_exists "$catalog" && ! catalog_is_available "$catalog"; then
    fail "model catalog exists but is unsafe or invalid: $catalog"
  fi
  if catalog_is_available "$catalog"; then
    catalog_has_tuple "$catalog" "$1" "$2" || fail "advisor tuple is not available in the local model catalog."
    catalog_has_tuple "$catalog" "$3" "$4" || fail "grunt tuple is not available in the local model catalog."
  fi
}

resolve_codex_config_file() {
  if [ -n "${CODEX_HOME-}" ]; then
    codex_home=$CODEX_HOME
  elif [ -n "${HOME-}" ]; then
    codex_home=$HOME/.codex
  else
    return 1
  fi
  case "$codex_home" in /*) ;; *) codex_home=$(pwd -P)/$codex_home ;; esac
  case "$codex_home" in /|//) return 1 ;; esac
  check_codex_config=$codex_home/config.toml
  [ -f "$check_codex_config" ] && [ ! -L "$check_codex_config" ] && [ -r "$check_codex_config" ]
}

# Observe Codex hooks.state. Trust hashes are version_for_toml of Codex's
# NormalizedHookIdentity (event, matcher, command handler), not script bytes.
# Missing python3 or an unreadable config stays unobservable; never invent trusted=true.
observe_codex_hook_trust() {
  check_hook_trust_observable=false
  check_hooks_trusted=false
  command -v python3 >/dev/null 2>&1 || return 0
  resolve_codex_config_file || return 0
  trust_json=$(python3 - "$check_codex_config" "$plugin_dir/hooks/hooks.json" <<'PY'
import hashlib
import json
import sys
import tomllib

def canonical(value):
    if isinstance(value, dict):
        return {key: canonical(value[key]) for key in sorted(value)}
    if isinstance(value, list):
        return [canonical(item) for item in value]
    return value

def version_for_identity(value):
    blob = json.dumps(canonical(value), separators=(",", ":"), ensure_ascii=True)
    return "sha256:" + hashlib.sha256(blob.encode("ascii")).hexdigest()

def normalize_timeout(raw):
    timeout = 600 if raw is None else int(raw)
    return timeout if timeout >= 1 else 1

EVENT_LABELS = {
    "SessionStart": "session_start",
    "PreToolUse": "pre_tool_use",
    "SubagentStart": "subagent_start",
}

def current_hashes(hooks_path):
    with open(hooks_path, encoding="utf-8") as handle:
        spec = json.load(handle)
    hooks = spec["hooks"]
    hashes = {}
    for event, label in EVENT_LABELS.items():
        group = hooks[event][0]
        handler = group["hooks"][0]
        if handler.get("type") != "command":
            return {}
        matcher = group.get("matcher")
        if not isinstance(matcher, str) or not matcher:
            return {}
        command = handler.get("command")
        status = handler.get("statusMessage")
        if not isinstance(command, str) or not isinstance(status, str):
            return {}
        key = "sol-advisor@sol-advisor:hooks/hooks.json:%s:0:0" % label
        hashes[key] = version_for_identity({
            "event_name": label,
            "matcher": matcher,
            "hooks": [{
                "async": False,
                "command": command,
                "statusMessage": status,
                "timeout": normalize_timeout(handler.get("timeout")),
                "type": "command",
            }],
        })
    return hashes

def hooks_state(config_path):
    with open(config_path, "rb") as handle:
        data = tomllib.load(handle)
    hooks = data.get("hooks")
    if not isinstance(hooks, dict):
        return {}
    state = hooks.get("state")
    return state if isinstance(state, dict) else {}

config_path, hooks_path = sys.argv[1], sys.argv[2]
try:
    state = hooks_state(config_path)
except Exception:
    json.dump({"trustObservable": False, "trusted": False}, sys.stdout)
    raise SystemExit(0)
try:
    expected = current_hashes(hooks_path)
except Exception:
    expected = {}
trusted = bool(expected) and all(
    isinstance(state.get(key), dict) and state[key].get("trusted_hash") == digest
    for key, digest in expected.items()
)
json.dump({"trustObservable": True, "trusted": trusted}, sys.stdout)
PY
) || return 0
  printf '%s\n' "$trust_json" | jq -e '
    type == "object" and (.trustObservable | type == "boolean") and (.trusted | type == "boolean")
  ' >/dev/null 2>&1 || return 0
  check_hook_trust_observable=$(printf '%s\n' "$trust_json" | jq -r '.trustObservable')
  check_hooks_trusted=$(printf '%s\n' "$trust_json" | jq -r '.trusted')
}

resolve_zcode_config() {
  if [ -n "${ZCODE_CONFIG-}" ]; then
    zcode_config=$ZCODE_CONFIG
  else
    [ -n "${HOME-}" ] || fail "HOME is unset; set ZCODE_CONFIG."
    zcode_config=$HOME/.zcode/cli/config.json
  fi
  case "$zcode_config" in /*) ;; *) zcode_config=$(pwd -P)/$zcode_config ;; esac
  case "$zcode_config" in /|//) fail "refusing to use the filesystem root as ZCode config." ;; esac
}

zcode_four_settings_present() {
  jq -e '
    (.plugins.options["sol-advisor@sol-advisor"] | type == "object") and
    (.plugins.options["sol-advisor@sol-advisor"].advisor_model | type == "string" and length > 0) and
    (.plugins.options["sol-advisor@sol-advisor"].advisor_effort | type == "string" and length > 0) and
    (.plugins.options["sol-advisor@sol-advisor"].grunt_model | type == "string" and length > 0) and
    (.plugins.options["sol-advisor@sol-advisor"].grunt_effort | type == "string" and length > 0)
  ' "$1" >/dev/null 2>&1
}

write_zcode_plugin_settings() {
  advisor_model=$1 advisor_effort=$2 grunt_model=$3 grunt_effort=$4
  resolve_zcode_config
  zcode_parent=$(dirname "$zcode_config")
  if path_exists "$zcode_config"; then
    [ -f "$zcode_config" ] && [ ! -L "$zcode_config" ] && [ -r "$zcode_config" ] ||
      fail "ZCode config is unsafe or invalid and will not be replaced: $zcode_config"
    jq -e 'type == "object"' "$zcode_config" >/dev/null 2>&1 ||
      fail "ZCode config is not a JSON object and will not be replaced: $zcode_config"
  elif path_exists "$zcode_parent" && { [ -L "$zcode_parent" ] || [ ! -d "$zcode_parent" ]; }; then
    fail "ZCode config parent is not a real directory: $zcode_parent"
  fi
  mkdir -p "$zcode_parent" || fail "could not create ZCode config directory: $zcode_parent"
  staged=$(mktemp "$zcode_parent/.zcode-config.XXXXXX") || fail "could not stage ZCode plugin settings"
  cleanup_zcode_staged() { [ -z "${staged-}" ] || rm -f "$staged"; }
  trap cleanup_zcode_staged 0 HUP INT TERM
  if path_exists "$zcode_config"; then
    jq --arg advisor_model "$advisor_model" --arg advisor_effort "$advisor_effort" \
      --arg grunt_model "$grunt_model" --arg grunt_effort "$grunt_effort" '
      if type != "object" then error("invalid") else . end
      | .plugins = ((.plugins // {}) | if type == "object" then . else error("plugins") end)
      | .plugins.enabled = true
      | .plugins.enabledPlugins = ((.plugins.enabledPlugins // {}) | if type == "object" then . else error("enabledPlugins") end)
      | .plugins.enabledPlugins["sol-advisor@sol-advisor"] = true
      | .plugins.options = ((.plugins.options // {}) | if type == "object" then . else error("options") end)
      | .plugins.options["sol-advisor@sol-advisor"] = {
          advisor_model:$advisor_model,advisor_effort:$advisor_effort,
          grunt_model:$grunt_model,grunt_effort:$grunt_effort
        }
    ' "$zcode_config" > "$staged" || fail "could not merge Advisor settings into ZCode config"
  else
    jq -n --arg advisor_model "$advisor_model" --arg advisor_effort "$advisor_effort" \
      --arg grunt_model "$grunt_model" --arg grunt_effort "$grunt_effort" '
      {plugins:{enabled:true,enabledPlugins:{"sol-advisor@sol-advisor":true},
        options:{"sol-advisor@sol-advisor":{
          advisor_model:$advisor_model,advisor_effort:$advisor_effort,
          grunt_model:$grunt_model,grunt_effort:$grunt_effort}}}}
    ' > "$staged" || fail "could not render ZCode plugin settings"
  fi
  chmod 600 "$staged" || fail "could not secure staged ZCode config"
  mv -f "$staged" "$zcode_config" || fail "could not atomically install ZCode plugin settings"
  staged=
  trap - 0 HUP INT TERM
  printf '%s\n' "WROTE: $zcode_config"
}

odw_list_is_compatible() {
  jq -e --arg id "$odw_plugin_id" --arg version "$odw_required_version" '
    def rows:
      [(.installed[]? | {id:(.pluginId // .id // ""), version:(.version // ""), enabled}),
       (.installedPlugins[]? | {id:(.pluginId // .id // ""), version:(.version // ""), enabled}),
       (.plugins[]? | {id:(.pluginId // .id // ""), version:(.version // ""), enabled})];
    any(rows[]; .id == $id and .version == $version and .enabled == true)
  ' >/dev/null 2>&1
}

parse_host_only() {
  parsed_host= parsed_json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)
        [ "$#" -ge 2 ] || fail "--host requires a value."
        case "$2" in --*) fail "--host requires an explicit value." ;; esac
        [ -z "$parsed_host" ] || fail "--host was supplied more than once."
        parsed_host=$2
        shift 2
        ;;
      --json)
        [ "$parsed_json" -eq 0 ] || fail "--json was supplied more than once."
        parsed_json=1
        shift
        ;;
      *) fail "unknown or positional argument: $1" ;;
    esac
  done
  [ -n "$parsed_host" ] || fail "--host is required."
}

configure() {
  host= advisor_model= advisor_effort= grunt_model= grunt_effort=
  seen_advisor_model=0 seen_advisor_effort=0 seen_grunt_model=0 seen_grunt_effort=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)
        [ "$#" -ge 2 ] || fail "--host requires a value."
        [ -z "$host" ] || fail "--host was supplied more than once."
        host=$2; shift 2 ;;
      --advisor-model)
        [ "$#" -ge 2 ] || fail "--advisor-model requires a value."
        [ "$seen_advisor_model" -eq 0 ] || fail "--advisor-model was supplied more than once."
        seen_advisor_model=1; advisor_model=$2; shift 2 ;;
      --advisor-effort)
        [ "$#" -ge 2 ] || fail "--advisor-effort requires a value."
        [ "$seen_advisor_effort" -eq 0 ] || fail "--advisor-effort was supplied more than once."
        seen_advisor_effort=1; advisor_effort=$2; shift 2 ;;
      --grunt-model)
        [ "$#" -ge 2 ] || fail "--grunt-model requires a value."
        [ "$seen_grunt_model" -eq 0 ] || fail "--grunt-model was supplied more than once."
        seen_grunt_model=1; grunt_model=$2; shift 2 ;;
      --grunt-effort)
        [ "$#" -ge 2 ] || fail "--grunt-effort requires a value."
        [ "$seen_grunt_effort" -eq 0 ] || fail "--grunt-effort was supplied more than once."
        seen_grunt_effort=1; grunt_effort=$2; shift 2 ;;
      *) fail "unknown or positional argument: $1" ;;
    esac
  done
  case "$host" in
    codex|zcode) ;;
    *) fail "configure currently supports only --host codex or --host zcode." ;;
  esac
  [ "$seen_advisor_model" -eq 1 ] && [ "$seen_advisor_effort" -eq 1 ] &&
    [ "$seen_grunt_model" -eq 1 ] && [ "$seen_grunt_effort" -eq 1 ] ||
    fail "configure requires both complete advisor and grunt tuples."
  valid_model "$advisor_model" || fail "advisor model contains unsupported characters."
  valid_effort "$advisor_effort" || fail "advisor effort contains unsupported characters."
  valid_model "$grunt_model" || fail "grunt model contains unsupported characters."
  valid_effort "$grunt_effort" || fail "grunt effort contains unsupported characters."

  need jq
  require_catalog_tuples "$advisor_model" "$advisor_effort" "$grunt_model" "$grunt_effort"
  if [ "$host" = zcode ]; then
    write_zcode_plugin_settings "$advisor_model" "$advisor_effort" "$grunt_model" "$grunt_effort"
    printf '%s\n' 'Start a new ZCode session, then run `$advisor doctor --host zcode`.'
    return 0
  fi
  validate_config_dir
  if path_exists "$profile" && ! profile_is_valid "$profile"; then
    fail "existing Codex profile is unsafe or invalid and will not be replaced: $profile"
  fi

  mkdir -p "$config_dir" || fail "could not create Advisor configuration home: $config_dir"
  validate_config_dir
  staged=$(mktemp "$config_dir/.codex.json.XXXXXX") || fail "could not stage the Codex profile"
  cleanup_staged() { [ -z "${staged-}" ] || rm -f "$staged"; }
  trap cleanup_staged 0 HUP INT TERM
  jq -n --arg advisor_model "$advisor_model" --arg advisor_effort "$advisor_effort" \
    --arg grunt_model "$grunt_model" --arg grunt_effort "$grunt_effort" \
    '{schemaVersion:1,host:"codex",advisor:{model:$advisor_model,effort:$advisor_effort},grunt:{model:$grunt_model,effort:$grunt_effort}}' > "$staged" ||
    fail "could not render the Codex profile"
  chmod 600 "$staged" || fail "could not secure the staged Codex profile"
  mv -f "$staged" "$profile" || fail "could not atomically install the Codex profile"
  staged=
  trap - 0 HUP INT TERM
  printf '%s\n' "WROTE: $profile"
  printf '%s\n' 'Run `$advisor apply --host codex`, then start a new session.'
}

looks_like_cursor_cli() {
  name=$1
  command -v "$name" >/dev/null 2>&1 || return 1
  case "$name" in
    cursor-agent|cursor) return 0 ;;
    agent)
      "$name" --help 2>/dev/null | grep -Fq -- '--plugin-dir'
      ;;
    *) return 1 ;;
  esac
}

is_cursor_plugin_root() {
  [ -f "$1/.cursor-plugin/plugin.json" ] && [ ! -L "$1/.cursor-plugin/plugin.json" ] &&
    jq -e '.name == "sol-advisor"' "$1/.cursor-plugin/plugin.json" >/dev/null 2>&1
}

cursor_tree_complete() {
  [ -x "$1/plugins/sol-advisor/bin/advisor" ] &&
    [ -f "$1/plugins/sol-advisor/skills/advisor/SKILL.md" ] &&
    [ -f "$1/plugins/sol-advisor/skills/orchestration/SKILL.md" ] &&
    [ -f "$1/plugins/sol-advisor/hosts/cursor/commands/advisor.md" ] &&
    [ -f "$1/plugins/sol-advisor/hosts/cursor/hooks/hooks.json" ]
}

try_cursor_plugin_root() {
  source_name=$1
  path=$2
  [ -n "$path" ] || return 1
  case "$path" in /*) ;; *) path=$(pwd -P)/$path ;; esac
  if is_cursor_plugin_root "$path"; then
    check_plugin_root=$path
    check_plugin_root_source=$source_name
    return 0
  fi
  if [ -x "$path/bin/advisor" ] && [ -f "$path/skills/advisor/SKILL.md" ]; then
    parent=$(CDPATH= cd "$path/../.." && pwd) || return 1
    if is_cursor_plugin_root "$parent"; then
      check_plugin_root=$parent
      check_plugin_root_source=$source_name
      return 0
    fi
  fi
  return 1
}

resolve_cursor_plugin_root() {
  check_plugin_root=
  check_plugin_root_source=none
  try_cursor_plugin_root CURSOR_PLUGIN_ROOT "${CURSOR_PLUGIN_ROOT-}" && return 0
  try_cursor_plugin_root PLUGIN_ROOT "${PLUGIN_ROOT-}" && return 0
  if [ -n "${HOME-}" ]; then
    try_cursor_plugin_root local "$HOME/.cursor/plugins/local/sol-advisor" && return 0
  fi
  packaged_root=$(CDPATH= cd "$plugin_dir/../.." && pwd) || return 0
  if is_cursor_plugin_root "$packaged_root"; then
    check_plugin_root=$packaged_root
    check_plugin_root_source=packaged
  fi
}

probe_host() {
  check_cli_present=false check_cli_version= check_files_current=false
  check_hooks_configured=false check_hook_trust_observable=false check_hooks_trusted=false
  check_odw_version=$odw_required_version check_odw_compatible=false
  check_cli_binary= check_cli_kind=none check_plugin_root= check_plugin_root_source=none
  check_cursor_odw_host= check_activation_hook=false check_enforcement_hook=false
  case "$1" in
    codex) candidates=codex ;;
    zcode) candidates=zcode ;;
    cursor) candidates='cursor-agent agent cursor' ;;
    claude) candidates=claude ;;
    grok) candidates=grok ;;
    *) candidates= ;;
  esac
  for candidate in $candidates; do
    if [ "$1" = cursor ]; then
      looks_like_cursor_cli "$candidate" || continue
      check_cli_binary=$candidate
      case "$candidate" in
        cursor-agent) check_cli_kind=cursor-agent ;;
        agent) check_cli_kind=cursor-cli-agent ;;
        cursor) check_cli_kind=cursor ;;
        *) check_cli_kind=none ;;
      esac
    else
      command -v "$candidate" >/dev/null 2>&1 || continue
    fi
    check_cli_present=true
    check_cli_version=$("$candidate" --version 2>/dev/null | sed -n '1,2p' | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    if [ -z "$check_cli_version" ]; then
      check_cli_version=$("$candidate" about 2>/dev/null | sed -n '1,2p' | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    fi
    break
  done
  if [ "$1" = codex ]; then
    [ -f "$plugin_dir/hooks/hooks.json" ] && [ -f "$plugin_dir/hooks/enforce-codex.sh" ] && [ -f "$plugin_dir/hooks/session-context.sh" ] && check_hooks_configured=true
    observe_codex_hook_trust
    if sh "$installer" --profile "$profile" --check --check-role grunt >/dev/null 2>&1; then check_files_current=true; fi
    if [ "$check_cli_present" = true ] && plugin_list=$(codex plugin list --json 2>/dev/null); then
      if printf '%s\n' "$plugin_list" | odw_list_is_compatible; then
        check_odw_compatible=true
      fi
    fi
  elif [ "$1" = zcode ]; then
    { [ -f "$plugin_dir/.zcode-plugin/plugin.json" ] || [ -f "$plugin_dir/../../.zcode-plugin/plugin.json" ]; } &&
      [ -f "$plugin_dir/hosts/zcode/hooks/hooks.json" ] && [ -f "$plugin_dir/hosts/zcode/hooks/enforce.sh" ] && check_files_current=true
    if [ "$check_cli_present" = true ] && plugin_list=$(zcode plugins list --json 2>/dev/null); then
      if printf '%s\n' "$plugin_list" | odw_list_is_compatible; then
        check_odw_compatible=true
      fi
    fi
  elif [ "$1" = cursor ]; then
    [ "${ODW_HOST-}" = cursor ] && check_cursor_odw_host=cursor
    resolve_cursor_plugin_root
    if [ -n "$check_plugin_root" ] && cursor_tree_complete "$check_plugin_root"; then
      check_files_current=true
    elif [ -z "$check_plugin_root" ] && [ -x "$plugin_dir/bin/advisor" ] &&
      [ -f "$plugin_dir/skills/advisor/SKILL.md" ] &&
      [ -f "$plugin_dir/hosts/cursor/commands/advisor.md" ] &&
      [ -f "$plugin_dir/hosts/cursor/hooks/hooks.json" ]; then
      check_files_current=true
    fi
    cursor_hooks=$plugin_dir/hosts/cursor/hooks/hooks.json
    if [ -n "$check_plugin_root" ] && [ -f "$check_plugin_root/plugins/sol-advisor/hosts/cursor/hooks/hooks.json" ]; then
      cursor_hooks=$check_plugin_root/plugins/sol-advisor/hosts/cursor/hooks/hooks.json
    fi
    if [ -f "$cursor_hooks" ] && jq -e '.hooks | keys == ["sessionStart"]' "$cursor_hooks" >/dev/null 2>&1; then
      check_hooks_configured=true
      check_activation_hook=true
    fi
  fi
}

claude_diagnostics() {
  jq -n --argjson cli_present "$check_cli_present" --arg cli_version "$check_cli_version" '{
    seating:"defer_to_native_when_present",
    nativeAdvisor:"unverified",
    nativeOrchestrator:"ultracode",
    pluginStrict:false,
    odwDefault:false,
    followUp:"live_claude_opus_plan_fixture",
    cliPresent:$cli_present,
    cliVersion:$cli_version,
    gaps:[
      "opus_plan_surface_unmapped",
      "ultracode_attestation_unavailable",
      "resolved_effort_not_authoritative"
    ]
  }'
}

cursor_diagnostics() {
  jq -n --arg cli_binary "$check_cli_binary" --arg cli_kind "$check_cli_kind" \
    --arg plugin_root "$check_plugin_root" --arg plugin_root_source "$check_plugin_root_source" \
    --arg odw_host "$check_cursor_odw_host" \
    --argjson activation "$check_activation_hook" --argjson enforcement "$check_enforcement_hook" '{
      cliBinary:$cli_binary,cliKind:$cli_kind,pluginRoot:$plugin_root,pluginRootSource:$plugin_root_source,
      odwHost:$odw_host,activationHook:$activation,enforcementHook:$enforcement,
      nativeGaps:[
        "plugin_agents_cannot_pin_model_or_effort",
        "subagent_start_omits_child_effort",
        "subagent_stop_omits_child_model_and_effort",
        "hook_model_params_are_selected_settings",
        "hook_runner_fail_open"
      ],
      odwGaps:[
        "cursor_cli_has_no_effort_flag",
        "print_result_omits_model_and_effort",
        "stream_init_model_is_display_name",
        "requested_model_is_not_runtime_attestation",
        "no_role_or_parent_evidence"
      ]
    }'
}

doctor_result() {
  host=$1 code=$2 strict=$3 profile_source=$4 profile_valid=$5
  advisor_model=$6 advisor_effort=$7 advisor_observable=$8 advisor_available=$9
  shift 9
  grunt_model=$1 grunt_effort=$2 grunt_observable=$3 grunt_available=$4 native_lane=$5 odw_lane=$6
  jq -n --arg host "$host" --arg code "$code" --arg profile_path "$profile" --arg profile_source "$profile_source" \
    --arg advisor_model "$advisor_model" --arg advisor_effort "$advisor_effort" \
    --arg grunt_model "$grunt_model" --arg grunt_effort "$grunt_effort" \
    --arg native_lane "$native_lane" --arg odw_lane "$odw_lane" --arg cli_version "$check_cli_version" \
    --arg odw_version "$check_odw_version" \
    --argjson strict "$strict" --argjson profile_valid "$profile_valid" \
    --argjson advisor_observable "$advisor_observable" --argjson advisor_available "$advisor_available" \
    --argjson grunt_observable "$grunt_observable" --argjson grunt_available "$grunt_available" \
    --argjson cli_present "$check_cli_present" --argjson files_current "$check_files_current" \
    --argjson hooks_configured "$check_hooks_configured" --argjson hook_trust_observable "$check_hook_trust_observable" \
    --argjson hooks_trusted "$check_hooks_trusted" --argjson odw_compatible "$check_odw_compatible" \
    --arg odw_plugin_id "$odw_plugin_id" --arg odw_install_hint "$odw_install_hint" '
    {schemaVersion:1,host:$host,strict:$strict,code:$code,profileSource:$profile_source,profilePath:$profile_path,
     profileValid:$profile_valid,
     advisor:{model:$advisor_model,effort:$advisor_effort,observable:$advisor_observable,available:$advisor_available},
     grunt:{model:$grunt_model,effort:$grunt_effort,observable:$grunt_observable,available:$grunt_available},
     checks:{hostCli:{present:$cli_present,version:$cli_version},generatedFiles:{current:$files_current},
       hooks:{configured:$hooks_configured,trustObservable:$hook_trust_observable,trusted:$hooks_trusted},
       odwPlugin:{requiredVersion:$odw_version,pluginId:$odw_plugin_id,compatible:$odw_compatible,installHint:$odw_install_hint},
       runtimeAttestation:{required:true,observed:false}},
     nativeLane:$native_lane,odwLane:$odw_lane}
  '
  if [ "$check_odw_compatible" != true ] && { [ "$host" = codex ] || [ "$host" = zcode ]; }; then
    printf '%s\n' "HINT: $odw_install_hint (installed+enabled on this host). Marketplace package.json at $odw_required_version is not enough." >&2
  fi
}

doctor() {
  parse_host_only "$@"
  need jq
  probe_host "$parsed_host"
  case "$parsed_host" in
    cursor)
      doctor_result cursor runtime_effort_attestation_unavailable false none false '' '' false false '' '' false false disabled disabled |
        jq --argjson diagnostics "$(cursor_diagnostics)" '. + {diagnostics:$diagnostics}'
      return 1 ;;
    claude)
      doctor_result claude native_advisor_unverified false none false '' '' false false '' '' false false disabled disabled |
        jq --argjson diagnostics "$(claude_diagnostics)" '. + {diagnostics:$diagnostics}'
      return 1 ;;
    grok)
      doctor_result grok hook_failure_is_fail_open false none false '' '' false false '' '' false false disabled disabled
      return 1 ;;
    zcode)
      resolve_zcode_config
      profile=$zcode_config
      if [ ! -f "$zcode_config" ] || [ -L "$zcode_config" ] || [ ! -r "$zcode_config" ]; then
        doctor_result zcode plugin_settings_required false plugin false '' '' true false '' '' true false disabled disabled
        return 1
      fi
      zcode_settings=$(jq -ce '
        if .plugins.enabled == true and .plugins.enabledPlugins["sol-advisor@sol-advisor"] == true and
          (.plugins.options["sol-advisor@sol-advisor"] | type == "object" and keys == ["advisor_effort","advisor_model","grunt_effort","grunt_model"] and all(.[]; type == "string" and length > 0))
        then .plugins.options["sol-advisor@sol-advisor"] else error("invalid settings") end
      ' "$zcode_config" 2>/dev/null) || {
        doctor_result zcode plugin_settings_required false plugin false '' '' true false '' '' true false disabled disabled
        return 1
      }
      check_hooks_configured=true
      profile_advisor_model=$(printf '%s\n' "$zcode_settings" | jq -r '.advisor_model')
      profile_advisor_effort=$(printf '%s\n' "$zcode_settings" | jq -r '.advisor_effort')
      profile_grunt_model=$(printf '%s\n' "$zcode_settings" | jq -r '.grunt_model')
      profile_grunt_effort=$(printf '%s\n' "$zcode_settings" | jq -r '.grunt_effort')
      if ! valid_model "$profile_advisor_model" || ! valid_effort "$profile_advisor_effort" ||
        ! valid_model "$profile_grunt_model" || ! valid_effort "$profile_grunt_effort"; then
        doctor_result zcode invalid_plugin_settings false plugin false '' '' true false '' '' true false disabled disabled
        return 1
      fi
      doctor_result zcode runtime_attestation_required false plugin true \
        "$profile_advisor_model" "$profile_advisor_effort" true false \
        "$profile_grunt_model" "$profile_grunt_effort" true false pending pending
      return 1 ;;
    codex) ;;
    *) fail "unknown or excluded host: $parsed_host" ;;
  esac

  validate_config_dir
  if path_exists "$profile"; then
    if ! profile_is_valid "$profile"; then
      doctor_result codex invalid_profile false file false '' '' false false '' '' false false disabled disabled
      return 1
    fi
    profile_source=file
  else
    profile_source=built_in_default
    profile_advisor_model=$default_advisor_model
    profile_advisor_effort=$default_advisor_effort
    profile_grunt_model=$default_grunt_model
    profile_grunt_effort=$default_grunt_effort
  fi
  catalog=$(catalog_path)
  if ! catalog_is_available "$catalog"; then
    doctor_result codex model_capability_unverified false "$profile_source" true \
      "$profile_advisor_model" "$profile_advisor_effort" false false \
      "$profile_grunt_model" "$profile_grunt_effort" false false blocked blocked
    return 1
  fi
  advisor_available=false grunt_available=false
  if catalog_has_tuple "$catalog" "$profile_advisor_model" "$profile_advisor_effort"; then advisor_available=true; fi
  if catalog_has_tuple "$catalog" "$profile_grunt_model" "$profile_grunt_effort"; then grunt_available=true; fi
  if [ "$advisor_available" != true ] || [ "$grunt_available" != true ]; then
    doctor_result codex model_tuple_unavailable false "$profile_source" true \
      "$profile_advisor_model" "$profile_advisor_effort" true "$advisor_available" \
      "$profile_grunt_model" "$profile_grunt_effort" true "$grunt_available" blocked blocked
    return 1
  fi
  doctor_result codex activation_required false "$profile_source" true \
    "$profile_advisor_model" "$profile_advisor_effort" true true \
    "$profile_grunt_model" "$profile_grunt_effort" true true pending pending
  return 1
}

apply_zcode() {
  need jq
  resolve_zcode_config
  advisor_model=$default_advisor_model
  advisor_effort=$default_advisor_effort
  grunt_model=$default_grunt_model
  grunt_effort=$default_grunt_effort
  if path_exists "$zcode_config" && [ -f "$zcode_config" ] && [ ! -L "$zcode_config" ] && [ -r "$zcode_config" ] &&
    zcode_four_settings_present "$zcode_config"; then
    advisor_model=$(jq -r '.plugins.options["sol-advisor@sol-advisor"].advisor_model' "$zcode_config")
    advisor_effort=$(jq -r '.plugins.options["sol-advisor@sol-advisor"].advisor_effort' "$zcode_config")
    grunt_model=$(jq -r '.plugins.options["sol-advisor@sol-advisor"].grunt_model' "$zcode_config")
    grunt_effort=$(jq -r '.plugins.options["sol-advisor@sol-advisor"].grunt_effort' "$zcode_config")
    valid_model "$advisor_model" && valid_effort "$advisor_effort" &&
      valid_model "$grunt_model" && valid_effort "$grunt_effort" ||
      fail "existing ZCode plugin settings are present but unsafe."
  fi
  write_zcode_plugin_settings "$advisor_model" "$advisor_effort" "$grunt_model" "$grunt_effort"
  printf '%s\n' 'Start a new ZCode session after reviewing plugin settings. Sol/Ultra + Luna/High is one factory preset only.'
}

apply_profile() {
  parse_host_only "$@"
  [ "$parsed_json" -eq 0 ] || fail "apply does not accept --json."
  case "$parsed_host" in
    zcode) apply_zcode; return 0 ;;
    codex) ;;
    *) fail "apply currently supports only --host codex or --host zcode." ;;
  esac
  need jq
  validate_config_dir
  if path_exists "$profile"; then profile_is_valid "$profile" || fail "Codex profile is unsafe or invalid: $profile"; fi
  sh "$installer" --profile "$profile"
  printf '%s\n' 'Start a new Codex session after reviewing and trusting the Advisor hooks.'
}

snapshot_is_valid() {
  candidate=$1 expected_id=$2
  [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -r "$candidate" ] && [ "$(file_mode "$candidate")" = 600 ] || return 1
  jq -e --arg runtime_id "$expected_id" '
    type == "object" and keys == ["createdAt","host","policy","policyFingerprint","runtimeId","schemaVersion"] and
    .schemaVersion == 1 and .host == "codex" and .runtimeId == $runtime_id and
    (.runtimeId | test("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")) and
    (.createdAt | type == "string" and length > 0) and
    (.policyFingerprint | type == "string" and test("^[a-f0-9]{64}$")) and
    (.policy | type == "object" and keys == ["advisorEffort","advisorModel","gruntEffort","gruntModel"] and
      all(.[]; type == "string" and length > 0))
  ' "$candidate" >/dev/null 2>&1 || return 1
  canonical=$(jq -c '{advisorModel:.policy.advisorModel,advisorEffort:.policy.advisorEffort,gruntModel:.policy.gruntModel,gruntEffort:.policy.gruntEffort}' "$candidate") || return 1
  snapshot_advisor_model=$(printf '%s\n' "$canonical" | jq -r '.advisorModel')
  snapshot_advisor_effort=$(printf '%s\n' "$canonical" | jq -r '.advisorEffort')
  snapshot_grunt_model=$(printf '%s\n' "$canonical" | jq -r '.gruntModel')
  snapshot_grunt_effort=$(printf '%s\n' "$canonical" | jq -r '.gruntEffort')
  valid_model "$snapshot_advisor_model" && valid_effort "$snapshot_advisor_effort" &&
    valid_model "$snapshot_grunt_model" && valid_effort "$snapshot_grunt_effort" || return 1
  [ "$(printf '%s' "$canonical" | shasum -a 256 | awk '{print $1}')" = "$(jq -r '.policyFingerprint' "$candidate")" ]
}

remove_codex() {
  parse_host_only "$@"
  [ "$parsed_json" -eq 0 ] || fail "remove does not accept --json."
  [ "$parsed_host" = codex ] || fail "remove currently supports only --host codex."
  need jq
  validate_config_dir
  if path_exists "$profile" && ! profile_is_valid "$profile"; then
    fail "Codex profile is unsafe or invalid and will not be removed: $profile"
  fi
  if path_exists "$profile"; then
    profile_is_valid "$profile" || fail "Codex profile became invalid during remove preflight."
  else
    profile_grunt_model=$default_grunt_model
    profile_grunt_effort=$default_grunt_effort
  fi
  if [ -n "${ADVISOR_AGENT_DIR-}" ]; then agent_dir=$ADVISOR_AGENT_DIR
  elif [ -n "${CODEX_HOME-}" ]; then agent_dir=$CODEX_HOME/agents
  else [ -n "${HOME-}" ] || fail "HOME is unset; set ADVISOR_AGENT_DIR."; agent_dir=$HOME/.codex/agents
  fi
  case "$agent_dir" in /*) ;; *) agent_dir=$(pwd -P)/$agent_dir ;; esac
  if path_exists "$agent_dir" && { [ -L "$agent_dir" ] || [ ! -d "$agent_dir" ]; }; then fail "Codex agent directory is unsafe: $agent_dir"; fi
  role=$agent_dir/advisor-grunt.toml
  template=$plugin_dir/templates/codex-advisor-grunt.toml.in
  tmp_base=${TMPDIR:-/tmp}; case "$tmp_base" in /*) ;; *) tmp_base=/tmp ;; esac
  tmp_base=$(CDPATH= cd "$tmp_base" && pwd -P)
  expected_role=$(mktemp "$tmp_base/advisor-remove-role.XXXXXX") || fail "could not stage role comparison."
  cleanup_expected_role() { [ -z "${expected_role-}" ] || rm -f "$expected_role"; }
  trap cleanup_expected_role 0 HUP INT TERM
  sed -e "s|@GRUNT_MODEL@|$profile_grunt_model|g" -e "s|@GRUNT_EFFORT@|$profile_grunt_effort|g" "$template" > "$expected_role" || fail "could not render role comparison."
  if path_exists "$role"; then
    [ -f "$role" ] && [ ! -L "$role" ] && [ "$(file_mode "$role")" = 600 ] && cmp -s "$expected_role" "$role" ||
      fail "Codex role is modified or unsafe and will not be removed: $role"
  fi
  sessions_dir=$config_dir/sessions
  if path_exists "$sessions_dir" && { [ -L "$sessions_dir" ] || [ ! -d "$sessions_dir" ]; }; then
    fail "session snapshot path is unsafe: $sessions_dir"
  fi
  if [ -d "$sessions_dir" ]; then
    for candidate in "$sessions_dir"/*; do
      [ -e "$candidate" ] || [ -L "$candidate" ] || continue
      name=$(basename "$candidate")
      case "$name" in *.json) runtime_id=${name%.json} ;; *) fail "unowned file blocks Advisor session cleanup: $candidate" ;; esac
      snapshot_is_valid "$candidate" "$runtime_id" || fail "invalid session snapshot will not be removed: $candidate"
    done
  fi
  if path_exists "$role"; then
    [ -f "$role" ] && [ ! -L "$role" ] && [ "$(file_mode "$role")" = 600 ] && cmp -s "$expected_role" "$role" || fail "Codex role changed during remove preflight."
    rm "$role" || fail "could not remove Codex role: $role"
  fi
  if [ -d "$sessions_dir" ]; then
    for candidate in "$sessions_dir"/*.json; do
      [ -e "$candidate" ] || continue
      rm "$candidate" || fail "could not remove session snapshot: $candidate"
    done
    rmdir "$sessions_dir" 2>/dev/null || true
  fi
  if path_exists "$profile"; then rm "$profile" || fail "could not remove Codex profile: $profile"; fi
  rm -f "$expected_role"; expected_role=; trap - 0 HUP INT TERM
  printf '%s\n' 'Advisor-owned Codex role, profile, and session snapshots are absent.'
}

[ "$#" -gt 0 ] || { usage; exit 1; }
command_name=$1
shift
case "$command_name" in
  configure) configure "$@" ;;
  doctor) doctor "$@" ;;
  apply) apply_profile "$@" ;;
  remove) remove_codex "$@" ;;
  --help|-h|help) usage ;;
  *) fail "unknown command: $command_name" ;;
esac
